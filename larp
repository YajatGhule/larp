#!/usr/bin/env bash
# ── CONFIGURE THIS ─────────────────────
AUDIO_PATH="/home/loopero/Downloads/Colliding Stars - Marzuku.mp3"
FONT=28.0
# ───────────────────────────────────────

# Set system master volume to 70%
wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.70

# Kill any previous larp audio
[[ -f /tmp/larp_audio.pid ]] && kill "$(cat /tmp/larp_audio.pid)" 2>/dev/null

# Play song once in bg at 70% volume
mpv --no-video --volume=70 --pause=no "$AUDIO_PATH" > /dev/null 2>&1 &
echo $! > /tmp/larp_audio.pid

# Create a wrapper script to enforce the font size ONLY for these terminal panes
WRAPPER="/tmp/larp-wrapper"
echo '#!/usr/bin/env bash' > "$WRAPPER"
echo "exec kitty --override font_size=${FONT} --title larp-window -e bash -c \"\$*\"" >> "$WRAPPER"
chmod +x "$WRAPPER"

# Create simple scripts because hypr-layout crashes on spaces inside {}
# Custom Fastfetch config
cat > /tmp/larp-fastfetch.jsonc << 'EOF2'
{
  "logo": {
    "type": "small"
  },
  "modules": [
    "title", "separator", "os", "host", "kernel", "shell",
    "display", "de", "wm", "wmtheme", "theme", "icons", "font",
    "cpu", "gpu", "memory", "disk", "localip", "battery",
    "break", "colors"
  ]
}
EOF2

echo '#!/usr/bin/env bash' > /tmp/larp-fetch
echo 'fastfetch -c /tmp/larp-fastfetch.jsonc; echo; read -n1 -p "Press any key..."; exec bash' >> /tmp/larp-fetch
chmod +x /tmp/larp-fetch

echo '#!/usr/bin/env bash' > /tmp/larp-pipes
echo 'pipes.sh || bash' >> /tmp/larp-pipes
chmod +x /tmp/larp-pipes

echo '#!/usr/bin/env bash' > /tmp/larp-cmatrix
echo 'cmatrix -b || bash' >> /tmp/larp-cmatrix
chmod +x /tmp/larp-cmatrix

# Launch the 4 Hyprland windows (3 terminal panes, 1 GUI app: cavalier)
# Note: cavalier is NOT enclosed in {} so it runs directly as a GUI app
hypr-layout \
  --terminal "$WRAPPER" \
  'h(v({/tmp/larp-fetch}, {/tmp/larp-pipes}), v({/tmp/larp-cmatrix}, "flatpak run org.nickvision.cavalier"))'
